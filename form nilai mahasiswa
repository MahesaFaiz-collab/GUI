    private void btnHitungActionPerformed(java.awt.event.ActionEvent evt) {                                          
        String nama = txtNamaMahasiswa.getText().trim();
        if (nama.isEmpty()) {
        javax.swing.JOptionPane.showMessageDialog(this, 
                "Nama mahasiswa harus diisi!");
            txtNamaMahasiswa.requestFocus();
        return;
        }
        if (txtNilaiTugas.getText().trim().isEmpty()
        || txtNilaiUTS.getText().trim().isEmpty()
        || txtNilaiUAS.getText().trim().isEmpty()) {
        javax.swing.JOptionPane.showMessageDialog(this, 
                "Semua nilai harus diisi!");
        return;
        }
        try {
        double tugas = Double.parseDouble(txtNilaiTugas.getText().trim());
        double uts = Double.parseDouble(txtNilaiUTS.getText().trim());
        double uas = Double.parseDouble(txtNilaiUAS.getText().trim());
        if (tugas < 0 || tugas > 100
            || uts < 0 || uts > 100
            || uas < 0 || uas > 100) {
        javax.swing.JOptionPane.showMessageDialog(this, 
                "Setiap nilai harus berada pada rentang 0-100!");
        return;
        }
        double rata = (tugas + uts + uas) / 3.0;
        String status = (rata >= 75) ? "LULUS" : "TIDAK LULUS";
        jTextArea1.setText(
            "Nama: " + nama
            + "\nNilai Tugas: " + tugas
            + "\nNilai UTS: " + uts
            + "\nNilai UAS: " + uas
            + "\nRata-rata: " + String.format("%.2f", rata)
            + "\nStatus: " + status
        );
        } catch (NumberFormatException e) {
        javax.swing.JOptionPane.showMessageDialog(this,
            "Nilai harus diisi dengan angka yang valid!");
        }
    }                                         

    private void btnResetActionPerformed(java.awt.event.ActionEvent evt) {                                         
        txtNamaMahasiswa.setText("");
        txtNilaiTugas.setText("");
        txtNilaiUTS.setText("");
        txtNilaiUAS.setText("");
        jTextArea1.setText("");
        txtNamaMahasiswa.requestFocus();
    }                                        

