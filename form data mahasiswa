    private void btnSimpanActionPerformed(java.awt.event.ActionEvent evt) {                                          
        String nim = txtNim.getText().trim();
        String nama = txtNama.getText().trim();
        if (nim.isEmpty() || nama.isEmpty()) {
            javax.swing.JOptionPane.showMessageDialog(
        this, "NIM dan nama wajib diisi!"
        );
        return;
        }
        String prodi = String.valueOf(cmbProdi.getSelectedItem());
        String jenisKelamin;
        if (rdoLaki.isSelected()) {
            jenisKelamin = "Laki-laki";
        } else if (rdoPerempuan.isSelected()) {
            jenisKelamin = "Perempuan";
        } else {
            javax.swing.JOptionPane.showMessageDialog(
        this, "Pilih jenis kelamin!"
        );
        return;
        }
            dataMahasiswa = "NIM: " + nim
        + "\nNama: " + nama
        + "\nProgram Studi: " + prodi
        + "\nJenis Kelamin: " + jenisKelamin;
            javax.swing.JOptionPane.showMessageDialog(
        this, "Data berhasil disimpan sementara."
        );
    }                                         

    private void btnTampilkanActionPerformed(java.awt.event.ActionEvent evt) {                                             
        if (dataMahasiswa.isEmpty()) {
            javax.swing.JOptionPane.showMessageDialog(
        this, "Belum ada data yang disimpan!"
        );
        } else {
            txtHasil.setText(dataMahasiswa);
        }
    }                                            

    private void btnResetActionPerformed(java.awt.event.ActionEvent evt) {                                         
        txtNim.setText("");
        txtNama.setText("");
        cmbProdi.setSelectedIndex(0);
        buttonGroupJK.clearSelection();
        txtHasil.setText("");
        dataMahasiswa = "";
        txtNim.requestFocus();
    }                                        

